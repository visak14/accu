# AccuScript SLR Backend Environment Configuration
PORT=8080
MONGO_URI=mongodb://localhost:27017
DB_NAME=sympro_slr
SECRET_KEY=sympro-slr-secret-encryption-key-32b

# Default AI Provider (groq | openai | gemini | claude)
DEFAULT_LLM_PROVIDER=groq

# Optional Server-Level Fallback API Keys
